# ====================================================================
# 电商项目环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ====================================================================

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

# 数据库 (MySQL)
DB_NAME=dianshang
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# 测试账号（CI 中通过 GitHub Secrets 设置）
TEST_USER=test111
TEST_PASSWORD=1234567811
TEST_SELLER=seller111
TEST_SELLER_PASSWORD=1234567811
TEST_ADMIN=admin
TEST_ADMIN_PASSWORD=admin123456

# 测试目标环境
# 本地: http://localhost:8000/api/v1
# 预发: https://staging.example.com/api/v1
TEST_BASE_URL=http://localhost:8000/api/v1

# 支付回调密钥（用于 callback 接口测试）
CALLBACK_SECRET=dianshang_callback_secret_2026
